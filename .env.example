# Personal AI Employee - Silver Tier Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control
# Path to the Obsidian vault (absolute or relative)
VAULT_PATH=./vault

# Path to Google OAuth2 credentials file
CREDENTIALS_PATH=./credentials.json

# Gmail watcher polling interval in seconds
POLL_INTERVAL=60

# --- Silver Tier Additions ---

# Gmail SMTP for sending (requires App Password)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Mastodon API
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-mastodon-access-token

# WhatsApp watcher
WHATSAPP_SESSION_PATH=~/.whatsapp_session
WHATSAPP_KEYWORDS=urgent,asap,deadline,emergency

# --- Gold Tier Additions ---

# Odoo Community (local Docker instance)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_gold
ODOO_USER=admin
ODOO_PASSWORD=admin

# Meta Graph API (Facebook/Instagram)
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_PAGE_ID=your-page-id
META_IG_USER_ID=your-instagram-user-id

# X (Twitter) API v2
X_API_KEY=your-api-key
X_API_SECRET=your-api-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_SECRET=your-access-token-secret
